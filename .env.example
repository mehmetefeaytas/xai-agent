# XAI-Agent yapılandırması
# -------------------------
# Bu dosyayı ".env" olarak kopyalayıp düzenleyin:
#     cp .env.example .env
#
# Tüm değişkenler XAI_ ön adıyla okunur (bkz. src/xai_agent/config.py).
# Hiçbir değer zorunlu değil; varsayılanlar yerel Ollama'yı kullanır.


# ===========================================================================
# SEÇENEK 1 — Ollama (varsayılan, yerel, kurulum kolay)
# ===========================================================================
XAI_LLM_BACKEND=ollama
XAI_LLM_BASE_URL=http://localhost:11434/v1
XAI_LLM_MODEL=qwen2.5:7b-instruct
XAI_LLM_API_KEY=not-needed-for-local

# Kurulum:
#   brew install ollama
#   ollama serve
#   ollama pull qwen2.5:7b-instruct
#
# Not: Model tool-calling desteklemek ZORUNDA. qwen2.5:7b-instruct,
# llama3.1:8b ve mistral-nemo destekler; gemma2 DESTEKLEMEZ.


# ===========================================================================
# SEÇENEK 2 — Azure AI Foundry Local (Microsoft yığını, yerel)
# ===========================================================================
# XAI_LLM_BACKEND=foundry
# XAI_LLM_MODEL=phi-4-mini
#
# Kurulum (macOS):
#   brew tap microsoft/foundrylocal
#   brew install foundrylocal
#   foundry model run phi-4-mini
#
# Kurulum (Windows):
#   winget install Microsoft.FoundryLocal
#
# Foundry Local ONNX Runtime kullanır ve modeli kendisi indirir
# (FoundryLocalClient bootstrap=True ile başlatılır). base_url gerekmez.


# ===========================================================================
# SEÇENEK 3 — Azure OpenAI (bulut)
# ===========================================================================
# XAI_LLM_BACKEND=azure
# XAI_LLM_BASE_URL=https://<kaynak-adiniz>.openai.azure.com/openai/v1
# XAI_LLM_MODEL=gpt-4o-mini
# XAI_LLM_API_KEY=<api-anahtariniz>


# ===========================================================================
# Ortak ajan ayarları
# ===========================================================================
# Düşük sıcaklık şart: ajan yaratıcı olmamalı, aktarıcı olmalı.
XAI_LLM_TEMPERATURE=0.1
XAI_LLM_MAX_TOKENS=1400
XAI_LLM_TIMEOUT=180
XAI_AGENT_MAX_TOOL_ROUNDS=6
